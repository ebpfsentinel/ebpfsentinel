# eBPFsentinel - warden control-plane image (split / rootless-agent deployment)
#
# Build:  docker build -f Dockerfile.warden -t ebpfsentinel-warden .
#
# This is the privileged half of the split deployment: a small sidecar that holds
# the extended capabilities (CAP_SYS_ADMIN / CAP_NET_ADMIN / CAP_NET_RAW) and
# serves kernel operations to a fully rootless agent over an AF_UNIX socket. It
# holds no maps and loads one eBPF program of its own, the guard on program loads
# (lsm-bpf-load-guard), which refuses a load through the agent's BPF token not
# signed against the warden's keyring, where the kernel verifies signatures and
# bpf is in lsm= at boot. The agent loads its own programs against the bpffs the
# warden delegates. It answers only the narrow, typed, peer-authenticated
# `warden-proto` RPC: bpffs delegation (+ module-BTF/pcap fd hand-off), conntrack
# read/teardown, route programming, gratuitous ARP, and on-demand pcap sockets.
#
# Run (alongside a rootless agent sharing the socket volume):
#   docker run --cap-add SYS_ADMIN --cap-add NET_ADMIN --cap-add NET_RAW \
#     --network host -v warden-sock:/run/ebpfsentinel \
#     ebpfsentinel-warden serve /run/ebpfsentinel/warden.sock --uid 65534
#
# The warden binary is fully static (musl) and needs no libpcap (it opens raw
# AF_PACKET sockets directly), so the build is leaner than the agent image.

# ── Stage 1: build the warden binary ─────────────────────────────────

FROM rust:bookworm AS warden-builder

ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends musl-tools && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml deny.toml ./
COPY .cargo/ .cargo/
COPY crates/ crates/
COPY proto/ proto/
# The agent's seccomp profile is compiled into the warden, which installs it on
# a Kubernetes node when the chart asks for it.
COPY dist/seccomp/ dist/seccomp/

# Build only the `warden` control-plane binary (static, musl).
# Unset in a release build. ebpfsentinel-devimg sets them for a local test
# image: without whole-program LTO a one-line change relinks in seconds, not
# the minutes a fat LTO pass over the whole binary takes.
ARG CARGO_PROFILE_RELEASE_LTO
ARG CARGO_PROFILE_RELEASE_CODEGEN_UNITS
ARG CARGO_PROFILE_RELEASE_INCREMENTAL
# The target directory is a BuildKit cache mount: a rebuild after a source
# change recompiles the crates that changed, not every dependency. It is not
# part of any layer, so the binary is copied out in the same step.
RUN --mount=type=cache,id=warden-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=warden-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=warden-target,target=/build/target,sharing=locked \
        case "${TARGETARCH}" in \
        arm64) MUSL_TARGET="aarch64-unknown-linux-musl" ;; \
        *)     MUSL_TARGET="x86_64-unknown-linux-musl" ;; \
    esac && \
    rustup target add "${MUSL_TARGET}" && \
    cargo build --release --target "${MUSL_TARGET}" --bin warden && \
    cp "/build/target/${MUSL_TARGET}/release/warden" /build/warden

# ── Stage 2: minimal runtime image ──────────────────────────────────
#
# distroless/static: no libc, no shell, no package manager. The warden is a
# static musl binary, so nothing else is required.

FROM gcr.io/distroless/static-debian13

LABEL org.opencontainers.image.title="eBPFsentinel-warden" \
    org.opencontainers.image.description="Privileged kernel-operation control plane for a rootless eBPFsentinel agent" \
    org.opencontainers.image.source="https://github.com/ebpfsentinel/ebpfsentinel" \
    org.opencontainers.image.licenses="AGPL-3.0-only"

COPY --from=warden-builder /build/warden /usr/local/bin/warden

# The certificate the agent's eBPF loaders are signed for, written by
# `cargo xtask ebpf-build` beside the objects. At start the warden adds it to a
# kernel keyring of its own and hands the agent that keyring's serial, so the
# kernel verifies every signed program the agent loads against this build's
# key. The build context needs `ebpf-out/`, as for the agent image.
COPY ebpf-out/loader-signing.der /usr/local/share/ebpfsentinel/loader-signing.der

# The guard on program loads, built by `cargo xtask ebpf-build` beside the
# agent's objects and loaded by the warden itself, as root and without a token,
# held to the keyring above. Where the kernel does not verify signatures or bpf
# is not in lsm= at boot, the warden leaves it out and says why.
COPY ebpf-out/lsm-bpf-load-guard /usr/local/lib/ebpfsentinel/lsm-bpf-load-guard

# The warden serves on a socket under this directory, shared with the agent
# container via a volume. The agent connects with EBPFSENTINEL_WARDEN_SOCK.
ENV EBPFSENTINEL_WARDEN_SOCK=/run/ebpfsentinel/warden.sock

ENTRYPOINT ["/usr/local/bin/warden"]
CMD ["serve", "/run/ebpfsentinel/warden.sock", "--uid", "65534"]
