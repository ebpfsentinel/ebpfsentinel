[Unit]
Description=eBPFsentinel warden (privileged kernel-operation broker)
Documentation=https://github.com/ebpfsentinel/ebpfsentinel
After=network-online.target
Wants=network-online.target

# Same reasoning as the agent's: a warden that cannot start - no capability to
# open the pcap pool, a socket path it cannot bind - must stop retrying and be
# found failed rather than restarted every two seconds forever.
StartLimitBurst=5
StartLimitIntervalSec=300

# Stopped with the agent and never alone: `systemctl stop` is refused, and the
# agent's own stop command (`ebpfsentinel-agent stop`) takes the warden down
# with it through this binding. While the agent is between two restarts the
# binding holds, so a crash of the agent never costs the warden.
RefuseManualStop=yes
BindsTo=ebpfsentinel.service

[Service]
Type=simple

# Create /run/ebpfsentinel (the control-socket directory); removed on stop.
RuntimeDirectory=ebpfsentinel
RuntimeDirectoryMode=0755

# The warden is the privileged half of the split deployment. It loads no eBPF and
# holds no maps - it only answers the typed warden-proto RPC over the AF_UNIX
# socket: it delegates a bpffs (CAP_SYS_ADMIN), reads/tears down conntrack and
# programs routes (CAP_NET_ADMIN), opens the AF_PACKET pcap pool + emits
# gratuitous ARP (CAP_NET_RAW), and attaches the DLP uprobe to a process's libssl
# (CAP_SYS_PTRACE to reach /proc/<pid>/root, CAP_BPF + CAP_PERFMON for the link),
# all in the init namespaces. It runs as root, so it holds these implicitly; the
# token-only agent stays capability-less. On bare metal the warden and the agent
# share the host PID namespace, so /proc already names every process - no
# /host/proc bind-mount is needed (that is the containerized deployment's path).
#
# --user ebpfsentinel: the agent runs as its own unprivileged user and presents
# that uid over SO_PEERCRED. Only that uid is served; root is not.
#
# --policy: what the warden answers, read once when it starts. The agent binary
# writes it here, as root and before the agent runs, from the configuration the
# agent will read: every family that configuration does not use is refused, and
# the gateways, VIPs, ports and paths it names fence the rest. The directory is
# root's, so the agent can neither write the file nor replace it. A setting
# changed later takes effect for the warden at its next restart.
ExecStartPre=/usr/local/bin/ebpfsentinel-agent --config /etc/ebpfsentinel/config.yaml warden-policy --output-file /run/ebpfsentinel/warden-policy.json
ExecStart=/usr/local/bin/warden serve /run/ebpfsentinel/warden.sock --user ebpfsentinel --policy /run/ebpfsentinel/warden-policy.json
Restart=always
RestartSec=2s

# The warden answers one RPC at a time per connection and holds no eBPF, so its
# stop is the connection threads ending. It gets the agent's budget rather than
# a shorter one because the agent is stopped first and can be mid-call here:
# killing the broker under a call in flight is what turns an ordered stop into a
# socket error in the agent's last log line.
TimeoutStopSec=20s

# The warden confines itself before it serves (no new privileges, Landlock,
# a seccomp filter); these hold from the first instruction, before that.
# ProtectSystem=full rather than strict: a canary the file watch plants may
# sit in any data directory the configuration names. Tunables stay writable:
# the warden turns on TCP syncookies at start.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# What the broker uses and nothing else: DAC_OVERRIDE reaches a user's
# rootless Podman socket (mode 0600), NET_BIND_SERVICE binds the resolver's
# port 53 on the agent's behalf.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE

# No WatchdogSec: the warden has no loop of its own to be wedged in. It blocks
# on accept() and answers what arrives, so liveness is the agent's call
# timeouts (10s, from the agent side) rather than a keep-alive from here.

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
