[Unit]
Description=eBPFsentinel Network Security Agent
Documentation=https://github.com/ebpfsentinel/ebpfsentinel
After=network-online.target ebpfsentinel-warden.service
Wants=network-online.target
# The agent brokers the privileged kernel ops it cannot perform from its user
# namespace (conntrack/routes/ARP/pcap) to the warden, and needs it for the
# one-shot bpffs delegation at startup. `Wants` (not `Requires`) so a warden
# restart does not tear the agent down - the agent holds its own eBPF + maps and
# its warden client reconnects.
Wants=ebpfsentinel-warden.service

# A permanent failure must stop hammering the eBPF loader. Five starts inside
# five minutes, with RestartSec=5s below, is about half a minute of trying; past
# that the unit stays failed, where `systemctl status` finds it, instead of
# re-entering the loader every five seconds for as long as nobody looks.
StartLimitBurst=5
StartLimitIntervalSec=300

# `systemctl stop` and `systemctl restart` are refused: the way to stop the
# agent is `ebpfsentinel-agent stop --reason "..."`, which records who asked and
# why, then ends the agent with status 79 (below). Anything else that ends it -
# a `systemctl kill`, a signal, a crash - is restarted, and raised as an alert
# at the next start. This keeps an honest mistake and a careless script from
# switching the agent off; it does not hold against root, who can still edit
# this unit, and the agent raises a masked or edited unit within 30s.
RefuseManualStop=yes

[Service]
Type=simple

# eBPF is loaded EXCLUSIVELY through a BPF token, a user-namespace
# feature. The agent self-unshares a user namespace, has the warden delegate a
# bpffs over the socket, and loads its own eBPF through the token - holding NO
# capabilities over the host (no CAP_BPF). It runs as its own unprivileged
# user, never as root: its namespace root maps onto that user, so a compromised
# agent owns nothing on the host but its own state directory. The package
# creates the user (sysusers.d/ebpfsentinel.conf); the warden serves only it
# (`--user ebpfsentinel`). Files the configuration names (keys, certificates,
# feeds) must be readable by the group ebpfsentinel.
#
# Needs unprivileged user namespaces for this user. Ubuntu 24.04 and later
# gate them behind AppArmor (kernel.apparmor_restrict_unprivileged_userns=1):
# the package installs and loads a profile for the agent binary alone. A host
# that set user.max_user_namespaces=0, or an older Debian kernel with
# kernel.unprivileged_userns_clone=0, refuses them to every user; the agent
# names the setting at start.
User=ebpfsentinel
Group=ebpfsentinel
# No capability survives into the agent's process on the host: the bounding set
# is empty, so even a setuid binary it executed would grant none. The user
# namespace it creates starts with a full set of its own (the kernel resets the
# bounding set in a new user namespace), which is all the token needs.
CapabilityBoundingSet=
AmbientCapabilities=
# NoNewPrivileges stays off: under it AppArmor refuses the transition into the
# agent's profile, which is what grants the user namespace on Ubuntu.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# The agent creates a user namespace and a mount namespace and nothing else.
RestrictNamespaces=user mnt
# The host's /sys/fs/bpf is root's: the delegated bpffs is mounted on a
# directory the agent creates here, in its own mount namespace, the same tmpfs
# the compose deployment gives it.
TemporaryFileSystem=/sys/fs/bpf:mode=1777
# /var/lib/ebpfsentinel, owned by the agent's user (handed over on an upgrade
# from a root-owned install), the only place it writes.
StateDirectory=ebpfsentinel
StateDirectoryMode=0750

Environment=EBPFSENTINEL_WARDEN_SOCK=/run/ebpfsentinel/warden.sock

# The agent's bootstrap connects to the warden once (no retry), so wait for the
# broker to bind its socket before starting.
ExecStartPre=/bin/sh -c 'for _ in $(seq 1 100); do [ -S /run/ebpfsentinel/warden.sock ] && exit 0; sleep 0.1; done; echo "warden socket not ready" >&2; exit 1'
# Relative paths in the config resolve here, so the default audit, alert and
# rule-history stores (`data/*.redb`) land under /var/lib/ebpfsentinel/data
# rather than in a /data directory at the root of the host.
WorkingDirectory=/var/lib/ebpfsentinel
# The control API authenticates. When the config names no method, the agent
# draws a key at first start, logs it once and keeps it at
# /var/lib/ebpfsentinel/auth/api-key (0600 in a 0700 directory), reading it
# back on every later start. /healthz and /readyz answer without it.
ExecStart=/usr/local/bin/ebpfsentinel-agent --config /etc/ebpfsentinel/config.yaml
# `systemctl reload ebpfsentinel` re-reads the config file; the agent handles
# SIGHUP exactly like a file change or POST /api/v1/config/reload.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
# Status 79 is the agent's own stop command: final, and not a failure.
RestartPreventExitStatus=79
SuccessExitStatus=79

# `Restart=always` covers an agent that exits. It does nothing for one that
# is still running and no longer working: a ring-buffer reader wedged in a
# record handler leaves the process alive, the HTTP surface answering and the
# datapath undrained. So the agent reports its own liveness - it pings every
# 45s (systemd asks at half the interval) for as long as a reader is still
# passing over its ring buffers, which it does every 10ms whether or not
# traffic arrived, and withholds the ping once 60s have gone by without a pass.
# A stall therefore costs one restart, after at most 90s, and the same reading
# fails /readyz, so the systemd and Kubernetes deployments notice the same
# thing. The 60s/90s pair is pinned by a test in
# crates/infrastructure/src/constants.rs.
WatchdogSec=90s
# Without this the unit stays Type=simple and systemd refuses every
# notification, including the watchdog ping, and sets no NOTIFY_SOCKET for the
# agent to find - the keep-alive would be written nowhere and the watchdog would
# kill a healthy agent every 90s. Type is deliberately left simple: the agent
# does not send READY=1, so promoting it to notify would make systemd wait for a
# readiness message that never arrives.
NotifyAccess=main

# The whole stop has to fit in here or systemd SIGKILLs an agent that was
# stopping correctly: the servers drain in 5s, inside which a running capture
# closes its file in 2s, and a stop waiting on the warden can hold a brokered
# call for 10s. That worst case is 15s; this is it plus room, and the same
# number is the agent's half of the pod's terminationGracePeriodSeconds in the
# chart, which adds the 5s preStop hook to reach 30s.
TimeoutStopSec=20s

# Logging
StandardOutput=journal
StandardError=journal

# Required for eBPF maps
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
