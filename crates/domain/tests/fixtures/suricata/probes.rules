# Rules written to probe how Suricata reads each keyword family. Which of them
# Suricata loads is recorded in verdicts.txt by make-verdicts.sh, from a real
# Suricata binary; the signature parser is held to the same verdicts.
# header
alert tcp any any -> any any (msg:"plain"; content:"x"; sid:1000;)
drop tcp any any -> any any (msg:"drop"; content:"x"; sid:1001;)
reject tcp any any -> any any (msg:"reject"; content:"x"; sid:1002;)
rejectsrc tcp any any -> any any (msg:"rejectsrc"; content:"x"; sid:1003;)
pass tcp any any -> any any (msg:"pass"; content:"x"; sid:1004;)
alert tcp any any <> any any (msg:"both ways"; content:"x"; sid:1005;)
alert http any any => any any (msg:"transactional"; http.uri; content:"x"; sid:1006;)
alert tcp any any <- any any (msg:"backwards"; content:"x"; sid:1007;)
block tcp any any -> any any (msg:"unknown action"; content:"x"; sid:1008;)
alert foo any any -> any any (msg:"unknown protocol"; content:"x"; sid:1009;)
alert tcp any !80 -> any any (msg:"negated port"; content:"x"; sid:1010;)
alert tcp any [80,!81] -> any any (msg:"negation in list"; content:"x"; sid:1011;)
alert tcp any 1024: -> any :1023 (msg:"open ranges"; content:"x"; sid:1012;)
alert tcp any 90:80 -> any any (msg:"reversed range"; content:"x"; sid:1013;)
alert tcp any 70000 -> any any (msg:"port too large"; content:"x"; sid:1014;)
alert tcp any !any -> any any (msg:"negated any port"; content:"x"; sid:1015;)
alert tcp !any any -> any any (msg:"negated any address"; content:"x"; sid:1016;)
alert tcp [10.0.0.0/8,!10.1.0.0/16] any -> any any (msg:"address exception"; content:"x"; sid:1017;)
alert tcp 10.0.0.0/33 any -> any any (msg:"bad mask"; content:"x"; sid:1018;)
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"variables"; content:"x"; sid:1019;)
alert ip any any -> any any (msg:"ip"; content:"x"; sid:1020;)
alert icmp any any -> any any (msg:"icmp"; itype:8; sid:1021;)
alert tcp-pkt any any -> any any (msg:"tcp-pkt"; content:"x"; sid:1022;)
alert tcp-stream any any -> any any (msg:"tcp-stream"; content:"x"; sid:1023;)
alert pkthdr any any -> any any (msg:"pkthdr"; ttl:1; sid:1024;)
alert tcp any [80,81 -> any any (msg:"unclosed list"; content:"x"; sid:1025;)
alert tcp any any -> any any (msg:"no sid"; content:"x";)
alert tcp any any -> any any (msg:"sid twice"; content:"x"; sid:1027; sid:1027;)
alert tcp any any -> any any (msg:"text after"; content:"x"; sid:1028;) junk
alert tcp any any -> any any (msg:"options only"; sid:1029;)
alert tcp any any -> any any (msg:"unknown keyword"; content:"x"; frobnicate; sid:1030;)
alert tcp any any -> any any (MSG:"upper case keyword"; CONTENT:"x"; sid:1031;)
# meta
alert tcp any any -> any any (msg:"priority 0"; content:"x"; priority:0; sid:1040;)
alert tcp any any -> any any (msg:"priority 256"; content:"x"; priority:256; sid:1041;)
alert tcp any any -> any any (msg:"reference no comma"; content:"x"; reference:url; sid:1042;)
alert tcp any any -> any any (msg:"unknown classtype"; content:"x"; classtype:no-such-class; sid:1043;)
alert tcp any any -> any any (msg:"target bad"; content:"x"; target:somewhere; sid:1044;)
alert tcp any any -> any any (msg:"threshold"; content:"x"; threshold:type limit, track by_src, count 1, seconds 60; sid:1045;)
alert tcp any any -> any any (msg:"threshold twice"; content:"x"; threshold:type limit, track by_src, count 1, seconds 60; threshold:type limit, track by_src, count 1, seconds 60; sid:1046;)
alert tcp any any -> any any (msg:"threshold no track"; content:"x"; threshold:type limit, count 1, seconds 60; sid:1047;)
