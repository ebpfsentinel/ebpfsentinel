# An allow-list, not a deny-list: everything stays out of the build context
# unless named here. A deny-list has to foresee every directory that grows
# (target-docker/, fuzz/target/, Vagrant disks); a path a Dockerfile needs and
# this file forgets fails the build at once instead.
*
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!deny.toml
!.cargo/
!crates/
!proto/
!config/ebpfsentinel.yaml
!dist/seccomp/
!ebpf-out/
**/target/
